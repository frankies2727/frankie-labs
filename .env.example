# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Multiplayer relay (optional) -------------------------------------------
# Players on different networks usually can't connect directly, so WebRTC falls
# back to relaying through a TURN server. The app ships with a free public relay;
# set these to use your own instead (see "Playing across networks" in README.md).
# VITE_TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"
# VITE_TURN_USERNAME="username"
# VITE_TURN_CREDENTIAL="password"
