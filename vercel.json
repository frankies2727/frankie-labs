{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": { "env": { "VITE_KYB_SITE": "1" } },
  "rewrites": [
    { "source": "/illinois", "destination": "/illinois/index.html" },
    { "source": "/illinois/(.*)", "destination": "/illinois/index.html" },
    { "source": "/michigan", "destination": "/michigan/index.html" },
    { "source": "/michigan/(.*)", "destination": "/michigan/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
